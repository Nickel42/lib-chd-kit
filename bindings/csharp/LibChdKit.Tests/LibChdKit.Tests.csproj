<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-checking console test for the .NET binding (no test framework, so it
    restores without downloading packages). Exit code 0 = all checks passed.
      dotnet run -p:ChdmanLibDir=<dir containing chdkit.dll or libchdkit.dylib>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LibChdKit/LibChdKit.csproj" />
  </ItemGroup>

  <Import Project="../ChdmanNativeCopy.targets" />

</Project>
