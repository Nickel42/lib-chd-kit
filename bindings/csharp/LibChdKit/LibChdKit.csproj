<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET binding for lib-chd-kit, packed as a NuGet package with the native
    libraries under runtimes/<rid>/native/.

    The native binaries come from ChdmanNativeRoot, laid out as
      $(ChdmanNativeRoot)/win-x64/chdkit.dll
      $(ChdmanNativeRoot)/win-arm64/chdkit.dll
      $(ChdmanNativeRoot)/osx/libchdkit.dylib      (universal arm64 + x86_64)
    Any that are missing are left out of the package (with a warning), so a
    Windows-only package can be built on Windows alone. See
    bindings/csharp/README.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LibChdKit</RootNamespace>
    <AssemblyName>LibChdKit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <PackageId>LibChdKit</PackageId>
    <Version>1.0.0</Version>
    <Authors>lib-chd-kit contributors</Authors>
    <Description>MAME 0.289's CHD (Compressed Hunks of Data) tools as a .NET library: create, verify, copy and extract CHD images for CD (cue/bin, gdi, toc), DVD, hard disk, raw and laserdisc media. Output is byte-identical to chdman.</Description>
    <PackageTags>chd;chdman;mame;cd;iso;emulation;compression</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Nickel42/lib-chd-kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nickel42/lib-chd-kit</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <ChdmanNativeRoot Condition="'$(ChdmanNativeRoot)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/native</ChdmanNativeRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LibChdKit.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <ChdmanNativeWinX64>$(ChdmanNativeRoot)/win-x64/chdkit.dll</ChdmanNativeWinX64>
    <ChdmanNativeWinArm64>$(ChdmanNativeRoot)/win-arm64/chdkit.dll</ChdmanNativeWinArm64>
    <ChdmanNativeOsx>$(ChdmanNativeRoot)/osx/libchdkit.dylib</ChdmanNativeOsx>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ChdmanNativeWinX64)" Condition="Exists('$(ChdmanNativeWinX64)')" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
    <None Include="$(ChdmanNativeWinArm64)" Condition="Exists('$(ChdmanNativeWinArm64)')" Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false" />
    <None Include="$(ChdmanNativeOsx)" Condition="Exists('$(ChdmanNativeOsx)')" Pack="true" PackagePath="runtimes/osx/native/" Visible="false" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="ChdmanWarnMissingNative" BeforeTargets="GenerateNuspec">
    <Warning Condition="!Exists('$(ChdmanNativeWinX64)')" Text="lib-chd-kit: no win-x64 chdkit.dll at $(ChdmanNativeWinX64); the package won't run on x64 Windows." />
    <Warning Condition="!Exists('$(ChdmanNativeWinArm64)')" Text="lib-chd-kit: no win-arm64 chdkit.dll at $(ChdmanNativeWinArm64); the package won't run on ARM64 Windows." />
    <Warning Condition="!Exists('$(ChdmanNativeOsx)')" Text="lib-chd-kit: no libchdkit.dylib at $(ChdmanNativeOsx); the package won't run on macOS." />
  </Target>

</Project>
